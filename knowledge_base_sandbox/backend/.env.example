NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000

# MySQL (XAMPP defaults) — SEPARATE database from the EDMS itself
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pspf_edms_docs
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=change_this_docs_portal_access_secret
JWT_REFRESH_SECRET=change_this_docs_portal_refresh_secret
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=14d

# Where the auto-discovered .md content lives
CONTENT_DIR=./content
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=200

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# SMTP — used to email a newly-issued sandbox API key straight to the
# developer. If SMTP_HOST is left empty, key issuance still works and
# still shows the key on-screen to the admin — it just won't also be
# emailed, and the admin UI will say so.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PSPF EDMS Docs Portal <no-reply@pspf.co.sz>"
