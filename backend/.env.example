# ---------- App ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# ---------- MySQL (XAMPP defaults) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pspf_edms
DB_CONNECTION_LIMIT=10

# ---------- JWT ----------
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Encryption (envelope encryption for documents) ----------
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEK_BASE64=change_this_base64_32_byte_key
MASTER_KEK_VERSION=kek-local-dev-1

# ---------- Cloud storage ----------
# One of: aws_s3 | azure_blob | gcp_storage | local
ACTIVE_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# AWS S3
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=pspf-edms-documents

# Google Cloud Storage
GCP_PROJECT_ID=
GCP_KEY_FILE_PATH=./gcp-service-account.json
GCP_STORAGE_BUCKET=docsecure_test-bucket

# ---------- Social auth ----------
# Web OAuth client, project "pspf-edms" in Google Cloud Console.
# Authorized JavaScript origins on that client must include whatever
# origin the Flutter web app is actually served from (see
# IMPLEMENTATION_GUIDE.md #9) — currently only http://localhost:4000
# and https://edms.docsecuresd.com are registered there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PSPF EDMS <no-reply@pspf.co.sz>"

# ---------- SMS (Vonage) ----------
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=PSPFEDMS

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ---------- Capture & Scan: automated intake ----------
# Non-interactive service account (is_active=0, no password) that
# automated FTP/watched-folder/email captures are attributed to as
# owner/creator, since documents.owner_id/created_by are NOT NULL.
SYSTEM_INTAKE_USER_ID=7
# Default repository folder id new automated/manual-batch captures file
# into when no per-connector folder is configured.
CAPTURE_DEFAULT_FOLDER_ID=1
WATCHED_INTAKE_ROOT=./watched-intake
# Secrets for the two real network intake connectors — non-secret settings
# (host/user/path/interval/enabled) live in the integrations.config_json
# row instead (id='ftp' / id='email_intake').
FTP_INTAKE_PASSWORD=
IMAP_INTAKE_PASSWORD=

# Service-account bind password for Active Directory authentication
# (services/ad.service.js) — non-secret settings (url/bindDN/searchBase/
# searchFilter) live in the integrations.config_json row instead (id='ad').
AD_BIND_PASSWORD=

# ---------- Backup & Disaster Recovery ----------
# Full paths to the mysqldump/mysql CLI binaries — required on Windows/XAMPP
# where they aren't on PATH; on a normal Linux deployment these can be left
# as the bare command names below.
MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
MYSQL_CLI_PATH=C:/xampp/mysql/bin/mysql.exe
# Local scratch dir for the plaintext dump before it's encrypted (never
# uploaded/persisted in plaintext — deleted immediately after encryption).
BACKUP_TMP_DIR=./backup-tmp