# ---------- App ----------
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
CLIENT_URL=http://localhost:3000

# ---------- MySQL (XAMPP defaults) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pspf_edms
DB_CONNECTION_LIMIT=10

# ---------- JWT ----------
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------- Encryption (envelope encryption for documents) ----------
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEK_BASE64=REPLACE_WITH_32_BYTE_BASE64_KEY
MASTER_KEK_VERSION=kek-local-dev-1

# ---------- Cloud storage ----------
# One of: aws_s3 | azure_blob | gcp_storage | local
ACTIVE_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# AWS S3
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pspf-edms-documents

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=pspf-edms-documents

# Google Cloud Storage
GCP_PROJECT_ID=
GCP_KEY_FILE_PATH=./gcp-service-account.json
GCP_STORAGE_BUCKET=pspf-edms-documents

# ---------- Social auth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/auth/microsoft/callback

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.pspf.co.sz
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="PSPF EDMS <no-reply@pspf.co.sz>"

# ---------- SMS (Vonage) ----------
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=PSPFEDMS

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
