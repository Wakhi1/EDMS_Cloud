# Copy this file to .env in the same folder and fill in your values.
# Never commit the real .env — it holds a live API key.

# The deployed EDMS's base URL (no trailing slash needed).
API_BASE_URL=https://edms.example.gov

# Generated in the app: Administration / Integrations -> "Local
# watched-folder agent" -> Generate key. Shown once at creation — if lost,
# revoke it there and generate a new one.
API_KEY=

# Absolute path to the folder on this machine to watch. A network
# scanner's "scan to folder" feature can point here too.
WATCH_FOLDER=C:\Scans

# Optional: numeric id of the EDMS folder new records should be filed
# under. Ask your Records Administrator. If omitted, uploads without a
# resolvable folder fail per-file (visible in Capture & Scan's batch
# detail) rather than the whole run failing.
FOLDER_ID=
